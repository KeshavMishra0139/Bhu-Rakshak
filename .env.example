# ---- Server ----
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# ---- Prediction layer ----
# live_sim = real Open-Meteo data + static factors + bounded live variation (current default)
# model    = call the trained ML service at MODEL_URL (POST {MODEL_URL}/predict), same response schema
PREDICTION_MODE=live_sim
MODEL_URL=http://localhost:8000

# ---- Demo accounts (citizen@demo.in, officer@demo.in, admin@demo.in) ----
DEMO_PASSWORD=Demo@2026
# One-tap demo buttons on the login page. Set to false for any public deployment.
DEMO_LOGIN_ENABLED=true

# ---- Developer / Admin mode ----
# true for the hackathon demo. SET TO false FOR ANY PUBLIC DEPLOYMENT.
DEV_MODE_ENABLED=true
# Password for dev@demo.in. If empty, the developer account is not created and dev sign-in is refused.
DEV_PASSWORD=
# Optional second factor for dev sign-in. Leave empty to skip.
DEV_ACCESS_CODE=

# ---- Map services ----
# Sent as the `token` query parameter to the Bhuvan WMS service if your Bhuvan access requires one.
BHUVAN_TOKEN=
MAPPLS_API_KEY=
# Raster tile URL template from your Mappls console, containing {key}, {z}, {x}, {y}. Mappls appears as a basemap
# only when both MAPPLS_API_KEY and MAPPLS_TILE_URL are set.
MAPPLS_TILE_URL=

# ---- Database ----
DB_PATH=./var/bhu-rakshak.db
