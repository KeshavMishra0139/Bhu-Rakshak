  "about": {
    "title": "About & methodology",
    "intro": "Bhu-Rakshak is an early-warning and risk-management platform for landslides in Sikkim and the Darjeeling hills, built by Team ByteMatrix for Smart India Hackathon 2026 (SIH26001).",
    "pipeline": "How it works",
    "p_data": "Data",
    "p_data_d": "Hourly rainfall, soil moisture at five depths, temperature, snow and freezing level for each place, refreshed every 30 minutes. Slope, rock type, vegetation, past landslides and exposure come from stored layers.",
    "p_features": "Features",
    "p_features_d": "The raw data becomes landslide indicators: rain over 3, 24 and 72 hours, forecast rain, a soil saturation index, cloudburst and freeze–thaw flags.",
    "p_model": "Risk model",
    "p_model_d": "A weighted model combines triggering and susceptibility factors into a score from 0 to 1, with a confidence value and the main drivers. Levels change with hysteresis so they don't flicker.",
    "p_alerts": "Alerts",
    "p_alerts_d": "When a place rises to High or Critical, officers get a routed inbox message and residents get an alarm. Officers send bilingual alerts to the public.",
    "p_feedback": "Field feedback",
    "p_feedback_d": "Verified citizen and field reports mark a place as field-verified, which raises confidence and feeds future model training.",
    "status": "Current status",
    "status_d": "This prototype's risk engine is a configurable baseline: transparent weights anchored on live Open-Meteo data, with gentle live variation between weather updates. Our machine-learning model is being integrated behind the same interface. Slope, geology and exposure values are seed placeholders until official layers are connected. We do not publish accuracy figures until the model has been validated.",
    "credits": "Data and map credits",
    "c_openmeteo": "Weather and soil-moisture data by Open-Meteo.com, licensed under CC BY 4.0.",
    "c_bhuvan": "Thematic overlays: Bhuvan, ISRO / NRSC (shown when the service is reachable).",
    "c_boundary": "India's boundary is drawn from an official Survey of India file supplied by the deployer.",
    "team": "Team",
    "team_d": "Built by Team ByteMatrix.",
    "c_google": "Maps: Google Maps. Map data © Google.",
    "c_imd": "Weather warnings and nowcasts: India Meteorological Department (IMD), Ministry of Earth Sciences."
  },
